# Use either a TMDB API v3 key or a v4 read access token.
VITE_TMDB_API_KEY=
VITE_TMDB_READ_TOKEN=

# Friends watch parties (Supabase browser-safe values).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=


# Authorized public playback embed URL templates. These values are visible in the browser.
# Movie template must include {tmdb_id}.
# TV template must include {tmdb_id}, {season_number}, and {episode_number}.
VITE_MOVIE_EMBED_URL_TEMPLATE=https://vidcore.org/embed/movie/{tmdb_id}
VITE_TV_EMBED_URL_TEMPLATE=https://vidcore.org/embed/tv/{tmdb_id}/{season_number}/{episode_number}
